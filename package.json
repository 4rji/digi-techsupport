{
  "name": "digi-techsupport",
  "productName": "Digi TechSupport",
  "version": "1.0.0",
  "description": "Digi TechSupport TCP checker",
  "author": "Havi Arji <havi@4rji.com>",
  "homepage": "https://digi-techsupport.com/",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "serve-http": "node server-http.js"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.digitechsupport.app",
    "artifactName": "digi-techsupport-${version}.${ext}",
    "npmRebuild": false,
    "files": [
      "**/*",
      "!node_modules/cpu-features/**",
      "!digi-support-*",
      "!digi-support-*/**"
    ],
    "extraResources": [
      { "from": "build/icon.png", "to": "icon.png" },
      { "from": "build/icon.ico", "to": "icon.ico" }
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "identity": "-"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^10.0.1",
    "node-fetch": "^2.7.0",
    "ssh2": "^1.17.0",
    "store": "^2.0.12",
    "tar-stream": "^3.2.0"
  }
}
